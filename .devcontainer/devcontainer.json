{
  "name": "RESTful API · J3",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "humao.rest-client",
        "mechatroner.rainbow-csv"
      ]
    }
  },
  "forwardPorts": [8080, 8081, 8090],
  "portsAttributes": {
    "8080": { "label": "API Banque" },
    "8081": { "label": "BFF mobile" },
    "8090": { "label": "API Référentiel Clients" }
  },
  "postCreateCommand": "bash .devcontainer/preparer.sh"
}
