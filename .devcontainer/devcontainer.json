{
  "name": "RESTful API · J3",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided",
      "installTools": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "humao.rest-client",
        "mechatroner.rainbow-csv"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic"
      }
    }
  },
  "forwardPorts": [8080, 8081, 8090],
  "portsAttributes": {
    "8080": { "label": "API Banque", "onAutoForward": "notify" },
    "8081": { "label": "BFF mobile", "onAutoForward": "notify" },
    "8090": { "label": "API Référentiel Clients", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/preparer.sh"
}
